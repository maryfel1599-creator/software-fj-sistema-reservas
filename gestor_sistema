"""
Archivo: gestor_sistema.py

Este módulo administra las listas internas de clientes,
servicios y reservas del sistema.
"""

# Se importan las clases principales.
from cliente import Cliente
from servicios import Servicio
from reserva import Reserva

# Se importan las excepciones de búsqueda y duplicados.
from excepciones import (
    ClienteNoEncontradoError,
    ServicioNoEncontradoError,
    ReservaNoEncontradaError,
    RegistroDuplicadoError
)

# Se importa el registro de eventos.
from configuracion_log import registrar_evento


# Se crea la clase GestorSistema.
class GestorSistema:
    """
    Administra clientes, servicios y reservas sin base de datos.
    """

    def __init__(self):
        """
        Inicializa las listas internas del sistema.
        """

        self._clientes = []
        self._servicios = []
        self._reservas = []

        registrar_evento(
            "Gestor del sistema inicializado."
        )

    def registrar_cliente(self, cliente):
        """
        Registra un cliente en la lista interna.
        """

        if not isinstance(cliente, Cliente):
            raise TypeError(
                "El objeto recibido debe ser un Cliente."
            )

        for cliente_registrado in self._clientes:
            if cliente_registrado.documento == cliente.documento:
                raise RegistroDuplicadoError(
                    f"El cliente {cliente.documento} ya está registrado."
                )

        self._clientes.append(cliente)

        registrar_evento(
            f"Cliente agregado al gestor: {cliente.documento}"
        )

def registrar_servicio(self, servicio):
        """
        Registra un servicio en la lista interna.
        """

        if not isinstance(servicio, Servicio):
            raise TypeError(
                "El objeto recibido debe ser un Servicio."
            )

        for servicio_registrado in self._servicios:
            if servicio_registrado.codigo == servicio.codigo:
                raise RegistroDuplicadoError(
                    f"El servicio {servicio.codigo} ya está registrado."
                )

        self._servicios.append(servicio)

        registrar_evento(
            f"Servicio agregado al gestor: {servicio.codigo}"
        )

    def crear_reserva(
        self,
        codigo_reserva,
        documento_cliente,
        codigo_servicio,
        duracion
    ):
        """
        Crea una reserva usando un cliente y un servicio existentes.
        """

        for reserva_registrada in self._reservas:
            if reserva_registrada.codigo == str(codigo_reserva).strip():
                raise RegistroDuplicadoError(
                    f"La reserva {codigo_reserva} ya está registrada."
                )

        cliente = self.buscar_cliente(documento_cliente)
        servicio = self.buscar_servicio(codigo_servicio)

        reserva = Reserva(
            codigo_reserva,
            cliente,
            servicio,
            duracion
        )

        self._reservas.append(reserva)

        registrar_evento(
            f"Reserva agregada al gestor: {reserva.codigo}"
        )

        return reserva

    def buscar_cliente(self, documento):
        """
        Busca un cliente por su documento.
        """

        documento_buscado = str(documento).strip()

        for cliente in self._clientes:
            if cliente.documento == documento_buscado:
                return cliente

        raise ClienteNoEncontradoError(
            f"No se encontró el cliente {documento_buscado}."
        )

    def buscar_servicio(self, codigo):
        """
        Busca un servicio por su código.
        """

        codigo_buscado = str(codigo).strip()

        for servicio in self._servicios:
            if servicio.codigo == codigo_buscado:
                return servicio

        raise ServicioNoEncontradoError(
            f"No se encontró el servicio {codigo_buscado}."
        )

    def buscar_reserva(self, codigo):
        """
        Busca una reserva por su código.
        """

        codigo_buscado = str(codigo).strip()

        for reserva in self._reservas:
            if reserva.codigo == codigo_buscado:
                return reserva

        raise ReservaNoEncontradaError(
            f"No se encontró la reserva {codigo_buscado}."
        )
